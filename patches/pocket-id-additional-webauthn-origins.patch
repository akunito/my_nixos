+// additionalWebAuthnOrigins returns extra allowed WebAuthn origins from the
+// ADDITIONAL_WEBAUTHN_ORIGINS env var (comma-separated).
+//
+// PATCH(akunito): upstream hardcodes APP_URL as the only RP origin, which
+// rejects passkey assertions from the LiftCraft Android app's WebView. That
+// client presents an "android:apk-key-hash:<hash>" origin. Upstream PR #1665
+// was closed unread, so this must be re-applied on every version bump.
+func additionalWebAuthnOrigins() []string {
+	raw := os.Getenv("ADDITIONAL_WEBAUTHN_ORIGINS")
+	if raw == "" {
+		return nil
+	}
+
+	var out []string
+	for _, origin := range strings.Split(raw, ",") {
+		if origin = strings.TrimSpace(origin); origin != "" {
+			out = append(out, origin)
+		}
+	}
+
+	return out
+}
+
