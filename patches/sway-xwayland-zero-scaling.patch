+// --- xwayland_zero_scaling -------------------------------------------------
+// X11 coordinate space: every output is its physical (transformed) size at
+// (layout position * S), S = largest scale of any enabled output. Scaling all
+// positions by one factor keeps the outputs disjoint (an output's physical
+// extent never exceeds its logical extent * S); an output with a smaller
+// scale just leaves dead X11 space on its right/bottom.
+
+bool xwayland_zero_scaling_enabled(void) {
+	return config->xwayland_zero_scaling;
+}
+
+static double max_output_scale(void) {
+	double max = 1.0;
+	for (int i = 0; i < root->outputs->length; ++i) {
+		struct sway_output *output = root->outputs->items[i];
+		if (output->wlr_output->scale > max) {
+			max = output->wlr_output->scale;
+		}
+	}
+	return max;
+}
+
+double xwayland_output_scale(struct sway_output *output) {
+	if (!config->xwayland_zero_scaling || !output || !output->wlr_output) {
+		return 1.0;
+	}
+	return output->wlr_output->scale;
+}
+
+void xwayland_output_xbox(struct sway_output *output, struct wlr_box *box) {
+	struct wlr_box lbox;
+	wlr_output_layout_get_box(root->output_layout, output->wlr_output, &lbox);
+	if (!config->xwayland_zero_scaling) {
+		*box = lbox;
+		return;
+	}
+	double s = max_output_scale();
+	box->x = (int)round(lbox.x * s);
+	box->y = (int)round(lbox.y * s);
+	wlr_output_transformed_resolution(output->wlr_output,
+		&box->width, &box->height);
+}
+
+struct sway_output *xwayland_output_at_layout(double lx, double ly) {
+	struct wlr_output *wlr_output =
+		wlr_output_layout_output_at(root->output_layout, lx, ly);
+	if (!wlr_output) {
+		double cx, cy;
+		wlr_output_layout_closest_point(root->output_layout, NULL, lx, ly,
+			&cx, &cy);
+		wlr_output = wlr_output_layout_output_at(root->output_layout, cx, cy);
+	}
+	return wlr_output ? wlr_output->data : NULL;
+}
+
+static double box_distance_sq(struct wlr_box *box, double x, double y) {
+	double dx = x < box->x ? box->x - x :
+		(x >= box->x + box->width ? x - (box->x + box->width - 1) : 0);
+	double dy = y < box->y ? box->y - y :
+		(y >= box->y + box->height ? y - (box->y + box->height - 1) : 0);
+	return dx * dx + dy * dy;
+}
+
+struct sway_output *xwayland_output_at_x(int x, int y) {
+	struct sway_output *best = NULL;
+	double best_dist = 0;
+	for (int i = 0; i < root->outputs->length; ++i) {
+		struct sway_output *output = root->outputs->items[i];
+		struct wlr_box box;
+		xwayland_output_xbox(output, &box);
+		double dist = box_distance_sq(&box, x, y);
+		if (!best || dist < best_dist) {
+			best = output;
+			best_dist = dist;
+		}
+		if (dist == 0) {
+			break;
+		}
+	}
+	return best;
+}
+
+void xwayland_layout_to_x(struct sway_output *output, double lx, double ly,
+		int *x, int *y) {
+	if (!config->xwayland_zero_scaling || !output) {
+		*x = (int)round(lx);
+		*y = (int)round(ly);
+		return;
+	}
+	struct wlr_box lbox, xbox;
+	wlr_output_layout_get_box(root->output_layout, output->wlr_output, &lbox);
+	xwayland_output_xbox(output, &xbox);
+	double scale = output->wlr_output->scale;
+	*x = xbox.x + (int)round((lx - lbox.x) * scale);
+	*y = xbox.y + (int)round((ly - lbox.y) * scale);
+}
+
+void xwayland_x_to_layout(int x, int y, double *lx, double *ly) {
+	struct sway_output *output = config->xwayland_zero_scaling ?
+		xwayland_output_at_x(x, y) : NULL;
+	if (!output) {
+		*lx = x;
+		*ly = y;
+		return;
+	}
+	struct wlr_box lbox, xbox;
+	wlr_output_layout_get_box(root->output_layout, output->wlr_output, &lbox);
+	xwayland_output_xbox(output, &xbox);
+	double scale = output->wlr_output->scale;
+	*lx = lbox.x + (x - xbox.x) / scale;
+	*ly = lbox.y + (y - xbox.y) / scale;
+}
+
+bool xwayland_xdg_output_geometry(struct wlr_xdg_output_manager_v1 *manager,
+		struct wl_client *client, struct wlr_output_layout_output *layout_output,
+		struct wlr_box *box) {
+	if (!config->xwayland_zero_scaling) {
+		return false;
+	}
+	struct wlr_xwayland *xwayland = server.xwayland.wlr_xwayland;
+	if (!xwayland || !xwayland->server || client != xwayland->server->client) {
+		return false;
+	}
+	struct sway_output *output = layout_output->output->data;
+	if (!output) {
+		return false;
+	}
+	xwayland_output_xbox(output, box);
+	return true;
+}
+
+// Output a view is (going to be) drawn on: the one under the centre of its
+// pending content box, else its workspace's output, else the focused one.
+static struct sway_output *view_output(struct sway_view *view) {
+	struct sway_container *con = view->container;
+	if (con) {
+		struct sway_container_state *st = &con->pending;
+		if (st->content_width > 0 && st->content_height > 0) {
+			struct sway_output *output = xwayland_output_at_layout(
+				st->content_x + st->content_width / 2.0,
+				st->content_y + st->content_height / 2.0);
+			if (output) {
+				return output;
+			}
+		}
+		if (st->workspace && st->workspace->output) {
+			return st->workspace->output;
+		}
+	}
+	struct sway_seat *seat = input_manager_current_seat();
+	struct sway_workspace *ws = seat_get_focused_workspace(seat);
+	return ws ? ws->output : NULL;
+}
+
+double xwayland_view_surface_scale(struct sway_view *view) {
+	if (!config->xwayland_zero_scaling) {
+		return 1.0;
+	}
+	struct sway_xwayland_view *xwayland_view = (struct sway_xwayland_view *)view;
+	if (xwayland_view->scale > 0) {
+		return xwayland_view->scale;
+	}
+	return xwayland_output_scale(view_output(view));
+}
+
+// Apply the scale to the scene surface of the view's wl_surface (the direct
+// buffer child of the subsurface tree; X11 has no subsurfaces).
+static void xwayland_view_set_scale(struct sway_xwayland_view *xwayland_view,
+		double scale) {
+	xwayland_view->scale = scale;
+	if (!xwayland_view->surface_tree) {
+		return;
+	}
+	struct wlr_scene_node *node;
+	wl_list_for_each(node, &xwayland_view->surface_tree->children, link) {
+		if (node->type != WLR_SCENE_NODE_BUFFER) {
+			continue;
+		}
+		struct wlr_scene_surface *scene_surface =
+			wlr_scene_surface_try_from_buffer(wlr_scene_buffer_from_node(node));
+		if (scene_surface &&
+				scene_surface->surface == xwayland_view->view.surface) {
+			wlr_scene_surface_set_scale_override(scene_surface, scale);
+		}
+	}
+}
+
+static void unmanaged_apply_zero_scaling(struct sway_xwayland_unmanaged *surface) {
+	struct wlr_xwayland_surface *xsurface = surface->wlr_xwayland_surface;
+	double lx, ly;
+	xwayland_x_to_layout(xsurface->x, xsurface->y, &lx, &ly);
+	wlr_scene_node_set_position(&surface->surface_scene->buffer->node,
