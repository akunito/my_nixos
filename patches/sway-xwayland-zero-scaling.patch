diff --git a/sway/commands/xwayland_zero_scaling.c b/sway/commands/xwayland_zero_scaling.c
new file mode 100644
index 0000000..dc951b2
--- /dev/null
+++ b/sway/commands/xwayland_zero_scaling.c
@@ -0,0 +1,27 @@
+#include "sway/config.h"
+#include "log.h"
+#include "sway/commands.h"
+#include "util.h"
+
+struct cmd_results *cmd_xwayland_zero_scaling(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "xwayland_zero_scaling", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+
+#ifdef WLR_HAS_XWAYLAND
+	bool enabled = parse_boolean(argv[0], config->xwayland_zero_scaling);
+	// Changing it live would need every X11 window re-sized and Xwayland's
+	// screen re-announced; config.c keeps the old value on reload.
+	if (config->reloading && config->xwayland_zero_scaling != enabled) {
+		return cmd_results_new(CMD_FAILURE,
+				"xwayland_zero_scaling can only be changed at launch");
+	}
+	config->xwayland_zero_scaling = enabled;
+#else
+	sway_log(SWAY_INFO, "Ignoring `xwayland_zero_scaling` command, "
+		"sway hasn't been built with Xwayland support");
+#endif
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
