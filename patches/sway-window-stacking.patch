diff --git a/sway/desktop/transaction.c b/sway/desktop/transaction.c
--- a/sway/desktop/transaction.c
+++ b/sway/desktop/transaction.c
@@ -542,6 +542,28 @@
 		arrange_container(floater, floater->current.width, floater->current.height,
 			true, ws->gaps_inner);
 	}
+
+	// Every workspace's floaters share root->layers.floating and reparenting
+	// to an unchanged parent is a no-op, so the scene order drifts from the
+	// list order (pin band, z, sticky floaters re-added on a workspace
+	// switch). Restore it per layer; no scene update when already in order.
+	struct wlr_scene_tree *layers[] = { root->layers.floating,
+		root->layers.fullscreen, root->layers.fullscreen_global };
+	for (size_t l = 0; l < sizeof(layers) / sizeof(layers[0]); l++) {
+		struct wlr_scene_node *above = NULL;
+		for (int i = ws->current.floating->length - 1; i >= 0; i--) {
+			struct sway_container *floater = ws->current.floating->items[i];
+			struct wlr_scene_node *node = &floater->scene_tree->node;
+			if (node->parent != layers[l] ||
+					floater->current.fullscreen_mode != FULLSCREEN_NONE) {
+				continue;
+			}
+			if (above && node->link.next != &above->link) {
+				wlr_scene_node_place_below(node, above);
+			}
+			above = node;
+		}
+	}
 }
 
