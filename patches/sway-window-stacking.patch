+// Where arrange_children puts a tile's scene node.
+static struct wlr_scene_tree *lifted_home(struct sway_container *con) {
+	if (con->current.parent) {
+		return con->current.parent->content_tree;
+	}
+	return con->current.workspace ? con->current.workspace->layers.tiling : NULL;
+}
+
+void root_lift_tiled(struct sway_container *con) {
+	root_drop_lifted();
+	root->lifted = con;
+	root_arrange_lifted();
+}
+
+void root_drop_lifted(void) {
+	struct sway_container *con = root->lifted;
+	if (!con) {
+		return;
+	}
+	root->lifted = NULL;
+	struct wlr_scene_node *node = &con->scene_tree->node;
+	struct wlr_scene_tree *home = lifted_home(con);
+	if (node->parent != root->layers.lifted || !home) {
+		return;
+	}
+	int hx, hy;
+	wlr_scene_node_coords(&home->node, &hx, &hy);
+	wlr_scene_node_reparent(node, home);
+	wlr_scene_node_set_position(node, node->x - hx, node->y - hy);
+}
+
+// Every transaction re-parents tiles into their workspace (arrange_children),
+// including the one the lifting click commits, so a one-shot reparent would
+// not survive: this runs at the end of each arrange_root.
+void root_arrange_lifted(void) {
+	struct sway_container *con = root->lifted;
+	if (!con) {
+		return;
+	}
+	struct wlr_scene_node *node = &con->scene_tree->node;
+	int lx, ly;
+	if (node->parent != lifted_home(con) ||
+			!wlr_scene_node_coords(node, &lx, &ly)) {
+		// Not laid out as a visible tile any more: floated, fullscreen,
+		// workspace hidden or covered by a fullscreen view.
+		root_drop_lifted();
+		return;
+	}
+	wlr_scene_node_reparent(node, root->layers.lifted);
+	wlr_scene_node_set_position(node, lx, ly);
+}
