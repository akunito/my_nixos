diff --git a/sway/commands/pin.c b/sway/commands/pin.c
new file mode 100644
--- /dev/null
+++ b/sway/commands/pin.c
@@ -0,0 +1,27 @@
+#include "sway/commands.h"
+#include "sway/tree/container.h"
+#include "util.h"
+
+struct cmd_results *cmd_pin(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "pin", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct sway_container *container = config->handler_context.container;
+	if (container == NULL) {
+		return cmd_results_new(CMD_FAILURE, "No current container");
+	}
+	container = container_toplevel_ancestor(container);
+
+	bool pinned = parse_boolean(argv[0], container->pinned);
+	if (pinned && !container_is_floating(container)) {
+		return cmd_results_new(CMD_FAILURE,
+				"Can only pin floating containers");
+	}
+	if (pinned != container->pinned) {
+		container->pinned = pinned;
+		// Top of the band it now belongs to.
+		container_raise_floating(container);
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
