 static const struct sway_seatop_impl seatop_impl = {
@@ -232,6 +241,43 @@
 	transaction_commit_dirty();
 }
 
+static bool floater_overlaps(struct sway_container *con) {
+	for (int i = 0; i < root->outputs->length; i++) {
+		struct sway_output *output = root->outputs->items[i];
+		struct sway_workspace *ws = output_get_active_workspace(output);
+		if (!ws) {
+			continue;
+		}
+		for (int j = 0; j < ws->floating->length; j++) {
+			struct sway_container *f = ws->floating->items[j];
+			if (f->pending.x < con->pending.x + con->pending.width &&
+					con->pending.x < f->pending.x + f->pending.width &&
+					f->pending.y < con->pending.y + con->pending.height &&
+					con->pending.y < f->pending.y + f->pending.height) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+void seatop_down_lift_tiled(struct sway_seat *seat) {
+	if (seat->seatop_impl != &seatop_impl) {
+		return;
+	}
+	struct seatop_down_event *e = seat->seatop_data;
+	struct sway_container *con = e->con;
+	struct sway_workspace *ws = con ? con->pending.workspace : NULL;
+	if (!ws || ws->fullscreen || root->fullscreen_global ||
+			container_is_floating_or_child(con) ||
+			container_is_fullscreen_or_child(con) ||
+			!floater_overlaps(con)) {
+		return;
+	}
+	root_lift_tiled(con);
+	e->lifted = true;
+}
