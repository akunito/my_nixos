diff --git a/sway/commands/z.c b/sway/commands/z.c
new file mode 100644
--- /dev/null
+++ b/sway/commands/z.c
@@ -0,0 +1,42 @@
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/tree/container.h"
+#include "sway/tree/workspace.h"
+#include "list.h"
+
+// One step up or down the workspace's floating list, never across the pin
+// band boundary; the list order is applied to the scene by the arrange.
+struct cmd_results *cmd_z(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "z", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	bool raise = strcasecmp(argv[0], "raise") == 0;
+	if (!raise && strcasecmp(argv[0], "lower") != 0) {
+		return cmd_results_new(CMD_INVALID, "Expected 'z raise|lower'");
+	}
+	struct sway_container *container = config->handler_context.container;
+	if (container == NULL) {
+		return cmd_results_new(CMD_FAILURE, "No current container");
+	}
+	container = container_toplevel_ancestor(container);
+	struct sway_workspace *ws = container->pending.workspace;
+	if (!container_is_floating(container) || !ws) {
+		return cmd_results_new(CMD_FAILURE,
+				"Can only restack floating containers");
+	}
+
+	list_t *floating = ws->floating;
+	int i = list_find(floating, container);
+	int j = raise ? i + 1 : i - 1;
+	if (i < 0 || j < 0 || j >= floating->length) {
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+	struct sway_container *other = floating->items[j];
+	if (other->pinned != container->pinned) {
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+	list_swap(floating, i, j);
+	node_set_dirty(&ws->node);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
