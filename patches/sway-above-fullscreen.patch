diff --git a/sway/commands/above_fullscreen.c b/sway/commands/above_fullscreen.c
new file mode 100644
index 0000000..333d276
--- /dev/null
+++ b/sway/commands/above_fullscreen.c
@@ -0,0 +1,35 @@
+#include "sway/commands.h"
+#include "sway/input/seat.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/container.h"
+#include "util.h"
+
+struct cmd_results *cmd_above_fullscreen(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "above_fullscreen", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct sway_container *container = config->handler_context.container;
+	if (container == NULL) {
+		return cmd_results_new(CMD_FAILURE, "No current container");
+	}
+
+	container->above_fullscreen =
+		parse_boolean(argv[0], container->above_fullscreen);
+
+	// Disabled while focused: hand focus back to the fullscreen view instead
+	// of leaving keyboard input on a container that is no longer drawn.
+	struct sway_container *fs =
+		container_obstructing_fullscreen_container(container);
+	struct sway_seat *seat = config->handler_context.seat;
+	struct sway_container *focus = seat_get_focused_container(seat);
+	if (fs && focus && (focus == container ||
+			container_has_ancestor(focus, container))) {
+		seat_set_focus_container(seat, fs);
+	}
+
+	if (container->pending.workspace) {
+		arrange_workspace(container->pending.workspace);
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
